{
  "name": "hephaestus",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "typecheck": "tsc -b packages/core packages/ledger packages/sandbox packages/engine packages/workers packages/node packages/cli",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "bun test",
    "heph": "bun run packages/cli/src/main.ts",
    "build:heph": "bun build --compile packages/cli/src/main.ts --outfile dist/heph --external omp-legacy-pi-modules"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
